@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="display-5 fw-bold">
            Welcome to RaceDay, @ViewBag.FirstName!
        </h1>
        <p class="lead text-muted">
            Find your next challenge and get race ready.
        </p>
        <a asp-controller="Participant"
           asp-action="MyEnrollments"
           class="btn btn-outline-primary mb-4">
            My Enrollments
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }

    <h2 class="h3 mb-4">Explore Events</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are available right now.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(
                            raceEvent.BannerImageUrl))
                        {
                            <img src="@raceEvent.BannerImageUrl"
                                 class="card-img-top"
                                 alt="@raceEvent.Name"
                                 style="height:200px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-dark text-white d-flex
                                align-items-center justify-content-center"
                                 style="height:150px;">
                                <span class="fw-bold fs-4">
                                    RACEDAY
                                </span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-primary align-self-start mb-2">
                                @raceEvent.EventType
                            </span>

                            <h3 class="h5 card-title">
                                @raceEvent.Name
                            </h3>

                            <p class="text-muted small mb-2">
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p class="text-muted small mb-2">
                                <strong>Location:</strong>
                                @raceEvent.Location
                            </p>

                            <p class="text-muted small mb-3">
                                <strong>Distance:</strong>
                                @raceEvent.DistanceKm km
                            </p>

                            <p class="card-text">
                                @raceEvent.Description
                            </p>

                            <div class="mt-auto">

                                @if (raceEvent.EventDate.Date >= DateTime.Today)
                                {
                                    <span class="badge bg-success">
                                        Upcoming
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Past event
                                    </span>
                                }
                                <a asp-controller="Participant"
                                   asp-action="Details"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-primary w-100 mt-3">
                                    View Event Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>