
@{
    ViewData["Title"] = "Welcome to RaceDay";
}

<div class="container py-5">
    <div class="text-center py-5">
        <h1 class="display-3 fw-bold">RaceDay</h1>

        <p class="lead mt-3">
            Your race. Your pace. Your finish line.
        </p>

        <p class="text-muted mx-auto" style="max-width: 650px;">
            Discover running events, explore race routes, register
            for your next challenge, and track your results.
        </p>

        <div class="mt-4">
            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary btn-lg me-2">
                Log In
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-outline-primary btn-lg">
                Create Account
            </a>
        </div>
    </div>

    <div class="row g-4 mt-3">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <h2 class="h5">Discover Events</h2>
                    <p class="text-muted mb-0">
                        Find races and explore event details before entering.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <h2 class="h5">Manage Entries</h2>
                    <p class="text-muted mb-0">
                        Keep track of your enrollments and race categories.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <h2 class="h5">Track Results</h2>
                    <p class="text-muted mb-0">
                        View your finishing times and published positions.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
