@{
    ViewData["Title"] = "Organizer Dashboard";
}

<div class="container py-5">
    <h1 class="display-5 fw-bold">
        Welcome, @ViewBag.FirstName!
    </h1>

    <p class="text-muted mb-4">
        Your RaceDay organizer dashboard.
        Manage events and prepare for race day.
    </p>

    <div class="row g-4">

        <!-- My Events -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Events</h5>
                    <p>Create, edit and manage your events.</p>

                    <a asp-controller="Organizer"
                       asp-action="Events"
                       class="btn btn-primary">
                        View My Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Enrollments -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Enrollments</h5>
                    <p>View participants entering your events.</p>

                    <span class="badge bg-secondary">
                        Coming next
                    </span>
                </div>
            </div>
        </div>

        <!-- Race Results -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Race Results</h5>
                    <p>Record finish times and finishing positions.</p>

                    <span class="badge bg-secondary">
                        Coming next
                    </span>
                </div>
            </div>
        </div>

    </div>
</div>
